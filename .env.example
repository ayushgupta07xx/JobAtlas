# ===== Local Postgres (operational store) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobatlas
POSTGRES_USER=jobatlas
POSTGRES_PASSWORD=changeme-local-only
DATABASE_URL=postgresql+psycopg://jobatlas:changeme-local-only@localhost:5432/jobatlas

# ===== MongoDB (raw zone) =====
MONGO_URI=mongodb://localhost:27017
MONGO_DB=jobatlas_raw

# ===== Redpanda / Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ===== MinIO (local object store) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jobatlas-raw

# ===== Airflow =====
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=

# ===== PostHog (Cloud free tier) =====
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=

# ===== Adzuna API — register at https://developer.adzuna.com/ =====
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ===== Jobicy — public API, no key required currently =====

# ===== HuggingFace (for sentence-transformers model downloads) =====
HF_TOKEN=

# ===== GCP (transient; used during credit window only) =====
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=

# ===== Snowflake (30-day trial window only) =====
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jobatlas-raw-prod

# ===== Deploy targets =====
FLY_API_TOKEN=
VERCEL_TOKEN=
